<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot's default console output (same format as without this file) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- SQL log (replaces spring.jpa.show-sql) without the auto-finalize query that runs every second -->
    <appender name="SQL_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.kahoot.kahoot_backend.config.AutoFinalizeSqlLogFilter"/>
        <encoder>
            <pattern>Hibernate: %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_CONSOLE"/>
    </logger>
</configuration>
