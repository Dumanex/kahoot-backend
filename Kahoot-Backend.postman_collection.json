    {
      "name": "Question Management (Requires JWT)",
      "item": [
        {
          "name": "Get Questions for Quiz",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "questions"]
            }
          },
          "response": []
        },
        {
          "name": "Add Multiple Choice Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionType\": \"MULTIPLE_CHOICE\",\n  \"questionText\": \"What sound does a cat make?\",\n  \"timeLimitSeconds\": 20,\n  \"orderIndex\": 0,\n  \"answers\": [\n    {\n      \"answerText\": \"Meow\",\n      \"isCorrect\": true,\n      \"orderIndex\": 0,\n      \"symbol\": \"TRIANGLE\",\n      \"color\": \"RED\"\n    },\n    {\n      \"answerText\": \"Woof\",\n      \"isCorrect\": false,\n      \"orderIndex\": 1,\n      \"symbol\": \"CIRCLE\",\n      \"color\": \"BLUE\"\n    },\n    {\n      \"answerText\": \"Moo\",\n      \"isCorrect\": false,\n      \"orderIndex\": 2,\n      \"symbol\": \"DIAMOND\",\n      \"color\": \"YELLOW\"\n    },\n    {\n      \"answerText\": \"Quack\",\n      \"isCorrect\": false,\n      \"orderIndex\": 3,\n      \"symbol\": \"SQUARE\",\n      \"color\": \"GREEN\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "questions"]
            }
          },
          "response": []
        },
        {
          "name": "Add True/False Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionType\": \"TRUE_FALSE\",\n  \"questionText\": \"Dogs are mammals.\",\n  \"timeLimitSeconds\": 15,\n  \"orderIndex\": 1,\n  \"answers\": [\n    {\n      \"answerText\": \"True\",\n      \"isCorrect\": true,\n      \"orderIndex\": 0,\n      \"symbol\": \"TRIANGLE\",\n      \"color\": \"RED\"\n    },\n    {\n      \"answerText\": \"False\",\n      \"isCorrect\": false,\n      \"orderIndex\": 1,\n      \"symbol\": \"CIRCLE\",\n      \"color\": \"BLUE\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "questions"]
            }
          },
          "response": []
        },
        {
          "name": "Update Question",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionType\": \"MULTIPLE_CHOICE\",\n  \"questionText\": \"What sound does a cat make? (Updated)\",\n  \"timeLimitSeconds\": 25,\n  \"orderIndex\": 0,\n  \"answers\": [\n    {\n      \"answerText\": \"Meow\",\n      \"isCorrect\": true,\n      \"orderIndex\": 0,\n      \"symbol\": \"TRIANGLE\",\n      \"color\": \"RED\"\n    },\n    {\n      \"answerText\": \"Purr\",\n      \"isCorrect\": false,\n      \"orderIndex\": 1,\n      \"symbol\": \"CIRCLE\",\n      \"color\": \"BLUE\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Question",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}"]
            }
          },
          "response": []
