              "mode": "raw",
              "raw": "{\n  \"quizId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/games/host",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "host"]
