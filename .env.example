# Copy to .env and fill in the values. Never commit .env.

# --- Database (PostgreSQL) ---
# Host is "localhost" when the backend runs locally; docker-compose sets it to "postgres" for the backend container
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kahoot
DB_USERNAME=postgres
# Local development value; use a strong password in production
DB_PASSWORD=postgres

# --- JWT ---
# Plain string, at least 32 characters (e.g. output of: openssl rand -base64 48)
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Token lifetime in milliseconds (86400000 = 24 h)
JWT_EXPIRATION=86400000

# --- CORS / WebSocket ---
# Frontend origins allowed to call the API and connect to /ws, comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:63342,http://localhost:8080

# --- Uploads (images/audio for questions) ---
# Folder where files are stored (docker-compose overrides it with /app/uploads, backed by a volume)
UPLOAD_DIR=./uploads
# Public backend URL used to build links to uploaded files
UPLOAD_BASE_URL=http://localhost:8080
